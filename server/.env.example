# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke git.
APP_USERNAME=smartdefense
# Hash bcrypt dari password (bukan password mentah).
# Buat dengan:  npm run hash -- "PasswordAnda"
APP_PASSWORD_HASH=
# Secret acak untuk menandatangani cookie sesi.
# Buat dengan:  openssl rand -hex 32
SESSION_SECRET=
NODE_ENV=production
PORT=8080
